# Copy to .env.local and fill in. .env.local is gitignored.

# Solari cloud browsers, from getsolari.com. Key looks like slr_live_...
# Stealth is a paid-plan feature. Without it launches fall back to a plain browser
# and lib/solari.ts reports stealth: false, which weakens any bot-wall finding.
SOLARI_API_KEY=

# Groq, free tier. Model openai/gpt-oss-120b, set in lib/groq.ts. The agent's brain.
# Free tier is 8000 tokens a minute and 200000 a day, about seven ten-step runs.
GROQ_API_KEY=
